# ===== AI 漫画工坊 =====
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://your-endpoint

# ===== 账户域密钥 =====
# JWT 验签 key（必填，缺失拒绝启动）：openssl rand -hex 64
COMIC_JWT_KEY_HEX=replace_with_openssl_rand_hex_64
# 图形验证码签名密钥（必填，缺失拒绝启动）
COMIC_CAPTCHA_SECRET=replace_with_random_secret

# ===== 数据库 =====
# 不配走本地 SQLite（output/comic.db），配了走 MySQL
# COMIC_MYSQL_HOST=127.0.0.1
# COMIC_MYSQL_PORT=3306
# COMIC_MYSQL_USER=comic
# COMIC_MYSQL_PASSWORD=
# COMIC_MYSQL_DATABASE=comic
